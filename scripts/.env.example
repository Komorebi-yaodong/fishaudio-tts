# 复制为 .env 后填写。不要提交真实 API Key。
MODEL=s2.1-pro-free
API_KEY=sk-your-key

# 音色字典: {"<reference_id>": {"name": "...", "description": "..."}}
# 也可以改成多行，方便阅读和增删。
REFERENCE_LIST={
  "d32230f937164cf9b9e7c1fc320198b7": {
    "name": "高松灯", 
    "description": "臭企鹅高松灯"
  },
  "3a8286fcad3e4c4da6bca09a607988f6": {
    "name": "俏皮少女", 
    "description": "粘腻俏皮少女"
  },
  "918a8277663d476b95e2c4867da0f6a6": {
    "name": "豪迈将军", 
    "description": "名言是“会战兵力是80万对60万，优势在我”"
  }
}

# 备选写法：一行一个音色（id | 名称 | 描述 | 可选标签）
# VOICE_1=6293cb97de02464499af38b8300f2be0 | 暖男客服 | 温和、语速中等，适合客服与说明文 | 中文,男声
# VOICE_2=f3a2b90078d54a65af4b95f63bc7798e | Sheila | EN-US 女声，情绪细腻，适合叙事

DEFAULT_VOICE=d32230f937164cf9b9e7c1fc320198b7
SAVE_PATH=E:\TMP\Audio
PRESET=quality
FORMAT=mp3
LANGUAGE=

# 1 = 上传到 api.urusai.cc 免费文件床并返回 https 直链；0 = 只返回本地路径
SHARE=1
# 可选，不填也能上传
URUSAI_API_TOKEN=
